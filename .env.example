# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=axel
DB_PASSWORD=axel
DB_NAME=axel_task

# JWT (use long random strings in real environments; access != refresh)
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# First Super Admin (created by the idempotent seed)
SUPER_ADMIN_EMAIL=admin@axel.local
SUPER_ADMIN_PASSWORD=ChangeMe!SuperAdmin1

# argon2id parameters
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=no-reply@axel.local

# Storage (Cloudinary)
CLOUDINARY_URL=
