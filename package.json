{
  "name": "axel-task",
  "version": "0.2.0",
  "description": "axel-task backend API (Epic-01: User Management & Authentication)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "prepare": "husky",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/shared/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/shared/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/database/data-source.ts",
    "seed:super-admin": "ts-node src/database/seeds/seed-super-admin.ts",
    "test:load": "node test/load/concurrent-users.mjs"
  },
  "dependencies": {
    "@casl/ability": "6.8.1",
    "@nestjs/common": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.4",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "6.2.1",
    "@nestjs/typeorm": "10.0.2",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cloudinary": "2.10.0",
    "helmet": "7.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.13.0",
    "reflect-metadata": "0.2.2",
    "resend": "4.0.0",
    "rxjs": "7.8.1",
    "typeorm": "0.3.31",
    "uuid": "10.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.2.0",
    "@nestjs/testing": "10.4.4",
    "@testcontainers/postgresql": "10.13.2",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/node": "20.16.10",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "husky": "9.1.6",
    "jest": "29.7.0",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "supertest": "7.0.0",
    "testcontainers": "10.13.2",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ]
  },
  "jest": {
    "rootDir": ".",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testMatch": [
      "**/?(*.)+(spec).ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.e2e-spec\\.ts$",
      "/dist/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
